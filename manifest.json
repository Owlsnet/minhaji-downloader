{
  "manifest_version": 3,
  "name": "Minhaji PDF Downloader",
  "version": "3.2.0",
  "description": "Download full PDFs from minhaji.moe.gov.ae library — viewer capture plus full catalog browsing (KG1–G12, ASP/ADV/GEN, Teacher's Guides)",
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://minhaji.moe.gov.ae/*", "http://*/*", "https://*/*"],
      "js": ["injector.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}